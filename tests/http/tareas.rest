@baseUrl = http://localhost:3000
@token = JWT_AQUI

### Listar tareas por sprint
GET {{baseUrl}}/api/tareas?id_historia=1
Authorization: Bearer {{token}}

### Crear tarea
POST {{baseUrl}}/api/tareas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Crear pantalla de backlog",
  "descripcion": "Construir vista principal",
  "id_historia": 1,
  "id_usuario_responsable": 10,
  "prioridad": "alta",
  "tipo": "RF",
  "story_points": 5,
  "estado": "por_hacer",
  "estimacion_dias": 2,
  "orden_columna": 1
}

### Obtener tarea por id
GET {{baseUrl}}/api/tareas/1
Authorization: Bearer {{token}}

### Actualizar tarea
PUT {{baseUrl}}/api/tareas/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Actualizar pantalla de backlog",
  "prioridad": "media",
  "story_points": 8
}

### Eliminar tarea (soft delete)
DELETE {{baseUrl}}/api/tareas/1
Authorization: Bearer {{token}}

### Cambiar estado (solo asignados)
PATCH {{baseUrl}}/api/tareas/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "en_progreso"
}

### Actualizar orden
PUT {{baseUrl}}/api/tareas/1/orden
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orden_columna": 3
}

### Registrar tiempo real
PATCH {{baseUrl}}/api/tareas/1/tiempo-real
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tiempo_real": 6
}

### Asignar usuario
POST {{baseUrl}}/api/tareas/1/asignar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_usuario": 11
}

### Ver usuarios asignados
GET {{baseUrl}}/api/tareas/1/usuarios
Authorization: Bearer {{token}}

### Ver historial
GET {{baseUrl}}/api/tareas/1/historial
Authorization: Bearer {{token}}

### Agregar comentario
POST {{baseUrl}}/api/tareas/1/comentarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comentario": "Listo para la exposicion"
}

### Listar comentarios
GET {{baseUrl}}/api/tareas/1/comentarios
Authorization: Bearer {{token}}

### Eliminar comentario por endpoint global
DELETE {{baseUrl}}/api/tareas/comentarios/1
Authorization: Bearer {{token}}

### Asignar etiqueta
POST {{baseUrl}}/api/tareas/1/etiquetas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_etiqueta": 5
}

### Remover etiqueta
DELETE {{baseUrl}}/api/tareas/1/etiquetas/5
Authorization: Bearer {{token}}
