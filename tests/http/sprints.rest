@baseUrl = http://localhost:3000
@token = JWT_AQUI

### Listar sprints
GET {{baseUrl}}/api/sprints
Authorization: Bearer {{token}}

### Crear sprint
POST {{baseUrl}}/api/sprints
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_proyecto": 1,
  "nombre": "Sprint Expo",
  "meta": "Entrega para la expo",
  "fecha_inicio": "2026-04-07",
  "fecha_fin": "2026-04-21",
  "estado": "planeado",
  "velocidad_estimada": 20
}

### Obtener sprint por id
GET {{baseUrl}}/api/sprints/1
Authorization: Bearer {{token}}

### Actualizar sprint
PUT {{baseUrl}}/api/sprints/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_proyecto": 1,
  "nombre": "Sprint Expo v2",
  "meta": "Entrega para la expo v2",
  "fecha_inicio": "2026-04-07",
  "fecha_fin": "2026-04-28",
  "estado": "en_curso",
  "velocidad_estimada": 24
}

### Cambiar estado del sprint
PATCH {{baseUrl}}/api/sprints/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "en_curso"
}

### Eliminar sprint
DELETE {{baseUrl}}/api/sprints/1
Authorization: Bearer {{token}}